<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{6f3b1c52-8d0a-4b8e-9a57-2c7d4e1f90ab}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>run_app.py</StartupFile>
    <SearchPath>.</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>NeuralNetClassifier</Name>
    <RootNamespace>NeuralNetClassifier</RootNamespace>
    <IsWindowsApplication>False</IsWindowsApplication>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
    <TestFramework>Pytest</TestFramework>
    <UnitTestPattern>test*.py</UnitTestPattern>
    <UnitTestRootDirectory>tests</UnitTestRootDirectory>
    <SuppressEnvironmentCreationPrompt>True</SuppressEnvironmentCreationPrompt>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>false</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="app.py" />
    <Compile Include="config.py" />
    <Compile Include="conftest.py" />
    <Compile Include="run_app.py" />
    <Compile Include="src\__init__.py" />
    <Compile Include="src\data_loader.py" />
    <Compile Include="src\evaluation.py" />
    <Compile Include="src\experiments.py" />
    <Compile Include="src\mathutils.py" />
    <Compile Include="src\pnn.py" />
    <Compile Include="src\preprocessing.py" />
    <Compile Include="src\rbf.py" />
    <Compile Include="src\visualizations.py" />
    <Compile Include="tests\conftest.py" />
    <Compile Include="tests\test_data_loader.py" />
    <Compile Include="tests\test_evaluation.py" />
    <Compile Include="tests\test_experiments.py" />
    <Compile Include="tests\test_pnn.py" />
    <Compile Include="tests\test_preprocessing.py" />
    <Compile Include="tests\test_rbf.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="data\" />
    <Folder Include="results\" />
    <Folder Include="src\" />
    <Folder Include="tests\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include=".gitignore" />
    <Content Include="data\processed.cleveland.data" />
    <Content Include="data\README.md" />
    <Content Include="data\student-por.csv" />
    <Content Include="pytest.ini" />
    <Content Include="README.md" />
    <Content Include="requirements.txt" />
    <Content Include="results\README.md" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>